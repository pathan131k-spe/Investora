// DEMO WALLET API
app.get("/api/wallet", (req, res) => {
  if (!req.session.userId) {
    return res.status(401).json({
      success: false,
      message: "Please login first"
    });
  }

  const db = readDB();

  const userDeposits = (db.deposits || []).filter(
    deposit => deposit.userId === req.session.userId
  );

  const approved = userDeposits.filter(
    deposit => deposit.status === "approved"
  );

  const pending = userDeposits.filter(
    deposit => deposit.status === "pending"
  );

  const rejected = userDeposits.filter(
    deposit => deposit.status === "rejected"
  );

  const totalDeposited = approved.reduce(
    (sum, deposit) => sum + Number(deposit.amount || 0),
    0
  );

  const pendingAmount = pending.reduce(
    (sum, deposit) => sum + Number(deposit.amount || 0),
    0
  );

  res.json({
    success: true,
    wallet: {
      balance: totalDeposited,
      totalDeposited: totalDeposited,
      pendingAmount: pendingAmount,
      rejectedAmount: rejected.reduce(
        (sum, deposit) => sum + Number(deposit.amount || 0),
        0
      )
    }
  });
});



