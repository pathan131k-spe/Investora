{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/dashboard.html",
      "destination": "/frontend/dashboard.html"
    },
    {
      "source": "/investments.html",
      "destination": "/frontend/investments.html"
    },
    {
      "source": "/deposit.html",
      "destination": "/frontend/deposit.html"
    },
    {
      "source": "/transactions.html",
      "destination": "/frontend/transactions.html"
    },
    {
      "source": "/admin.html",
      "destination": "/frontend/admin.html"
    }
  ]
}
